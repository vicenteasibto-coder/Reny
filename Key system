-- HTTP request helper
local function getRequestFunction()
    return syn and syn.request or http_request or request or fluxus and fluxus.request
end

-- Check if player is blacklisted
local function checkBlacklist()
    local requestFunc = getRequestFunction()
    if not requestFunc then return nil end
    
    local response, success = pcall(function()
        return httpService:JSONDecode(requestFunc({
            Url = "https://mnxlovesu.shop/api/blacklist/check",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = httpService:JSONEncode({ username = localPlayer.Name })
        }).Body)
    end)
    
    if response and success and success.blacklisted then
        return true -- Blacklisted, should block execution
    end
    
    return false
end

-- Get IP information
local function getIPInfo()
    local success, result = pcall(function()
        return httpService:JSONDecode(game:HttpGet("http://ip-api.com/json/"))
    end)
    
    if success and result then
        return result.query or ""
    end
    return ""
end

-- Check if IP is blocked
local function checkIPBlocked(ip)
    local requestFunc = getRequestFunction()
    if not requestFunc or ip == "" then return false end
    
    local response, success = pcall(function()
        return requestFunc({
            Url = "https://mnxlovesu.shop/api/ipblocklist/check",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = httpService:JSONEncode({ ip = ip })
        })
    end)
    
    if response and success then
        local decoded = httpService:JSONDecode(success.Body)
        if decoded and decoded.blocked == true then
            return true
        end
    end
    
    return false
end

-- Main security check
local function performSecurityCheck()
    if checkBlacklist() then return end
    
    local ip = getIPInfo()
    if ip ~= "" and checkIPBlocked(ip) then return end
end

performSecurityCheck()

