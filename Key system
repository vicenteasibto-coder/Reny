    statusLabel.ZIndex = 4
    
    -- Submit button
    submitButton = Instance.new("TextButton", content)
    submitButton.Size = UDim2.new(1, -20, 0, 34)
    submitButton.Position = UDim2.fromOffset(10, statusY + 22)
    submitButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    submitButton.BorderSizePixel = 0
    submitButton.Text = "[ SUBMIT KEY ]"
    submitButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    submitButton.Font = Enum.Font.GothamBold
    submitButton.TextSize = 13
    submitButton.ZIndex = 5
    
    Instance.new("UICorner", submitButton).CornerRadius = UDim.new(0, 6)
    
    local submitStroke = Instance.new("UIStroke", submitButton)
    submitStroke.Color = Color3.fromRGB(255, 255, 255)
    submitStroke.Thickness = 0
    
    submitButton.MouseEnter:Connect(function()
        tweenService:Create(submitButton, TweenInfo.new(0.15, Enum.EasingStyle.Quint), {
            TextColor3 = Color3.fromRGB(200, 200, 200)
        }):Play()
    end)
    
    submitButton.MouseLeave:Connect(function()
        tweenService:Create(submitButton, TweenInfo.new(0.15, Enum.EasingStyle.Quint), {
            TextColor3 = Color3.fromRGB(255, 255, 255)
        }):Play()
    end)
    
    -- Scan animation
    local scanOffset = 0
    scanConnection = runService.Heartbeat:Connect(function(delta)
        scanOffset = (scanOffset + 30 * delta) % 290
        scanFrame.Position = UDim2.fromOffset(0, -scanOffset)
    end)
    
    -- Helper function for typewriter effect
    local function typewriterEffect(label, text, delay, color)
        label.Text = ""
        label.TextColor3 = color or Color3.fromRGB(255, 255, 255)
        
        for i = 1, #text do
            label.Text = text:sub(1, i)
            task.wait(delay or 0.03)
        end
    end
    
    -- Animation creator
    local function showAnimation(onComplete)
        keyInput.Visible = false
        keyLabel.Visible = false
        submitButton.Visible = false
        
        local animationSteps = {
            { text = "[INIT] Bootstrapping runtime...", color = Color3.fromRGB(255, 255, 255), delay = 0.03 },
            { text = "[SCAN] Detecting anti-cheat...", color = Color3.fromRGB(255, 200, 120), delay = 0.03 },
            { text = "[BYPASS] Patching IntegrityCheck...", color = Color3.fromRGB(255, 80, 80), delay = 0.03 },
            { text = "[BYPASS] Disabling SecuRev hooks...", color = Color3.fromRGB(255, 80, 80), delay = 0.03 },
            { text = "[STEALTH] Spoofing client signatures...", color = Color3.fromRGB(255, 255, 255), delay = 0.03 },
            { text = "[LOAD] ████████████████████ 100%", color = Color3.fromRGB(255, 255, 255), delay = 0.02 },
            { text = "[AUTH] Key Accepted..", color = Color3.fromRGB(138, 43, 226), delay = 0.06 }
        }
        
        local labels = {}
        
        for i = 1, #animationSteps do
            local label = Instance.new("TextLabel", content)
            label.Size = UDim2.new(1, -20, 0, 16)
            label.Position = UDim2.fromOffset(10, inputY - 8 + (i - 1) * 17)
            label.BackgroundTransparency = 1
            label.Text = ""
            label.Font = Enum.Font.Gotham
            label.TextSize = 11
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.ZIndex = 5
            
            table.insert(labels, label)
        end
        
        statusLabel.Text = ""
        
        task.spawn(function()
            for i, step in ipairs(animationSteps) do
                typewriterEffect(labels[i], step.text, step.delay, step.color)
                task.wait(0.12)
            end
            
            task.wait(0.3)
            
            -- Flash effect
            for i = 1, 3 do
                tweenService:Create(stroke, TweenInfo.new(0.1), {
                    Color = Color3.fromRGB(255, 255, 255),
                    Thickness = 1
                }):Play()
                task.wait(0.15)
                tweenService:Create(stroke, TweenInfo.new(0.1), {
                    Thickness = 0
                }):Play()
                task.wait(0.15)
            end
            
            task.wait(0.3)
            
            -- Fade out
            tweenService:Create(mainGui, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                BackgroundTransparency = 1,
                Position = UDim2.new(0.5, -260, 0.5, -165)
            }):Play()
            
            task.wait(0.6)
            
            if onComplete then
                onComplete()
            end
            
            if scanConnection then
                scanConnection:Disconnect()
            end
            
            keySystem:Destroy()
        end)
    end
    
    -- Process key submission
    local function processKey()
        if isProcessing then return end
        
        local key = keyInput.Text:gsub("%s+", ""):upper()
        if key == "" then return end        
        isProcessing = true
        
        if validateKey(key, localPlayer.Name) then
            keyInput.TextEditable = false
            
            statusLabel.Text = "> Checking..."
            statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            
            task.wait(0.5)
            
            showAnimation(function()
                task.spawn(function()
                    pcall(sendDiscordWebhook, key)
                    task.delay(3, showMOTD)
                end)
            end)
        else
            keyInput.Text = ""
            showInvalidKeyError(key)
            isProcessing = false
        end
    end
    
    -- Show invalid key error
    local function showInvalidKeyError(key)
        statusLabel.Text = "> Invalid Key."
        statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        
        for i = 1, 3 do
            tweenService:Create(stroke, TweenInfo.new(0.08), {
                Color = Color3.fromRGB(255, 60, 60),
                Thickness = 1
            }):Play()
            task.wait(0.1)
            tweenService:Create(stroke, TweenInfo.new(0.08), {
                Thickness = 0
            }):Play()
            task.wait(0.1)
        end
        
        task.wait(1)
        
        statusLabel.Text = ""
        statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        keyInput.TextEditable = true
        submitButton.Visible = true
    end
    
    isProcessing = false
    
    -- Connect events
    keyInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            processKey()
        end
    end)
    
    userInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.KeyCode == Enum.KeyCode.Return or 
           input.KeyCode == Enum.KeyCode.KeypadEnter then
            processKey()
        end
    end)
    
    submitButton.MouseButton1Click:Connect(processKey)
    submitButton.Activated:Connect(processKey)
    
    keyInput:GetPropertyChangedSignal("Text"):Connect(function()
        if statusLabel.Text ~= "" then
            statusLabel.Text = ""
            statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
    end)
    
    -- Animate in
    mainGui.BackgroundTransparency = 1
    mainGui.Position = UDim2.new(0.5, -260, 0.5, -127)
    
    tweenService:Create(
        mainGui,
        TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            BackgroundTransparency = 0,
            Position = UDim2.new(0.5, -260, 0.5, -145)
        }
    ):Play()
    
    -- Focus input and show status
    task.delay(0.4, function()
        pcall(function()
            keyInput:CaptureFocus()
        end)
    end)
    
    task.delay(0.5, function()
        typewriterEffect(statusLabel, "> Enter your key to continue.", 0.025)
    end)
end
